LLM_PROVIDER = gemini

OPENAI_API_KEY = your_openai_api_key_here
OPENAI_MODEL = gpt-4

GEMINI_API_KEY = your_gemini_api_key_here
GEMINI_MODEL = gemini-3.5-flash-lite

# Anthropic configuration (not the default provider yet - requires a standalone
# API key, since a Claude Pro/Max subscription alone does not grant API access)
ANTHROPIC_API_KEY = your_anthropic_api_key_here
ANTHROPIC_MODEL = claude-sonnet-5

# Days a cached analysis stays valid even if the page content hash hasn't changed
CACHE_TTL_DAYS = 7

# Postgres connection string (e.g. a Neon pooled connection string). Required -
# there is no SQLite fallback.
DATABASE_URL = postgresql://user:password@host/dbname?sslmode=require

# Comma-separated allowed CORS origins. Leave as "*" for local dev. The
# extension's ID is deterministic (derived from manifest.json's "key" field,
# see extension-key.pem), so production is locked to that exact origin:
# ALLOWED_ORIGINS = chrome-extension://lehedpfliplncengpmfhjgopclpfmmnp
ALLOWED_ORIGINS = *

# Max real (non-cached) /analyze calls served per day before returning 429.
DAILY_ANALYZE_BUDGET = 150
