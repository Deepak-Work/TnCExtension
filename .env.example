LLM_PROVIDER = gemini

OPENAI_API_KEY = your_openai_api_key_here
OPENAI_MODEL = gpt-4

GEMINI_API_KEY = your_gemini_api_key_here
GEMINI_MODEL = gemini-3.5-flash-lite

# Anthropic configuration (not the default provider yet - requires a standalone
# API key, since a Claude Pro/Max subscription alone does not grant API access)
ANTHROPIC_API_KEY = your_anthropic_api_key_here
ANTHROPIC_MODEL = claude-sonnet-5

# Days a cached analysis stays valid even if the page content hash hasn't changed
CACHE_TTL_DAYS = 7
